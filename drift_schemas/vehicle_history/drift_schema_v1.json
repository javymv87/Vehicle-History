    {
      "name": "owners",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"owners\" (\"id\" TEXT NOT NULL, \"created_at\" TEXT NOT NULL, \"updated_at\" TEXT NOT NULL, \"deleted\" INTEGER NOT NULL DEFAULT 0 CHECK (\"deleted\" IN (0, 1)), \"first_name\" TEXT NOT NULL, \"last_name\" TEXT NULL, \"birth_date\" TEXT NULL, \"nationality\" TEXT NULL, \"phone\" TEXT NULL, \"email\" TEXT NULL, \"notes\" TEXT NULL, \"photo_path\" TEXT NULL, PRIMARY KEY (\"id\"), CHECK (length(trim(first_name)) > 0));"
        }
      ]
    },
    {
      "name": "vehicles",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"vehicles\" (\"id\" TEXT NOT NULL, \"created_at\" TEXT NOT NULL, \"updated_at\" TEXT NOT NULL, \"deleted\" INTEGER NOT NULL DEFAULT 0 CHECK (\"deleted\" IN (0, 1)), \"plate\" TEXT NOT NULL, \"nickname\" TEXT NULL, \"owner_id\" TEXT NOT NULL REFERENCES owners (id) ON DELETE RESTRICT, \"current_odometer_km\" INTEGER NOT NULL, \"fuel_type\" TEXT NOT NULL, \"recommended_engine_oil\" TEXT NULL, \"manufacturer_notes\" TEXT NULL, \"photo_path\" TEXT NULL, PRIMARY KEY (\"id\"), CHECK (length(trim(plate)) > 0), CHECK (current_odometer_km >= 0));"
        }
      ]
    },
    {
      "name": "audit_log",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"audit_log\" (\"id\" TEXT NOT NULL, \"entity_type\" TEXT NOT NULL, \"entity_id\" TEXT NOT NULL, \"operation\" TEXT NOT NULL, \"at\" TEXT NOT NULL, PRIMARY KEY (\"id\"));"
        }
      ]
    },
