<?xml version="1.0" encoding="utf-8"?>
<!-- Android's cloud backup and device transfer from Android 12
     (android:dataExtractionRules). Same exclusions as backup_rules.xml:
     flutter_secure_storage's files never leave the phone. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="FlutterSecureStorage.xml" />
        <exclude domain="sharedpref" path="FlutterSecureKeyStorage.xml" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="FlutterSecureStorage.xml" />
        <exclude domain="sharedpref" path="FlutterSecureKeyStorage.xml" />
    </device-transfer>
</data-extraction-rules>
